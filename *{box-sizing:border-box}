*{box-sizing:border-box}
:root{
  --bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#6b7280;--line:#e6eaf0;
  --primary:#2563eb;--primary-dark:#1d4ed8;--success:#16a34a;--danger:#dc2626;
  --sidebar:#111827;--sidebar-text:#cbd5e1;--shadow:0 8px 30px rgba(15,23,42,.07);
  --radius:14px;
}
html,body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}
.app{min-height:100vh;display:flex}
.sidebar{width:250px;background:var(--sidebar);color:#fff;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;z-index:30}
.brand{height:76px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.08)}
.brand strong{display:block;font-size:16px}.brand span{display:block;color:#94a3b8;font-size:12px;margin-top:2px}
.brand-mark{width:40px;height:40px;border-radius:11px;background:linear-gradient(135deg,#3b82f6,#7c3aed);display:grid;place-items:center;color:#fff;font-weight:800}
nav{padding:18px 12px;display:grid;gap:6px}
.nav-item{border:0;background:transparent;color:var(--sidebar-text);padding:12px 14px;border-radius:10px;text-align:left;display:flex;align-items:center;gap:12px}
.nav-item:hover,.nav-item.active{background:#1f2937;color:#fff}.nav-item.active{box-shadow:inset 3px 0 var(--primary)}
.sidebar-footer{margin-top:auto;padding:18px;color:#64748b;font-size:12px}
.main{margin-left:250px;min-width:0;flex:1}
.topbar{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 28px;gap:16px;position:sticky;top:0;z-index:20}
.topbar h2{margin:0;font-size:20px}.breadcrumb{font-size:12px;color:var(--muted);margin-top:4px}
.top-actions{margin-left:auto;display:flex;align-items:center;gap:10px}
.icon-btn{border:0;background:transparent;padding:9px;border-radius:9px}.icon-btn:hover{background:#f1f5f9}
#menuBtn{display:none}
.user-pill{display:flex;align-items:center;gap:8px;font-size:13px}.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#dbeafe;color:#1d4ed8;font-weight:700}
.content{padding:28px;max-width:1600px;margin:auto}
.grid{display:grid;gap:18px}.cards{grid-template-columns:repeat(4,minmax(0,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.stat{padding:20px}.stat-top{display:flex;justify-content:space-between;color:var(--muted);font-size:13px}.stat-value{font-size:27px;font-weight:750;margin-top:12px}.stat-note{font-size:12px;color:var(--muted);margin-top:6px}
.section{padding:20px}.section-header{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:16px}.section-header h3{margin:0;font-size:16px}
.two-col{grid-template-columns:1.4fr .8fr;margin-top:18px}
.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:680px}.table th,.table td{padding:12px 10px;border-bottom:1px solid var(--line);font-size:13px;text-align:left}.table th{color:var(--muted);font-weight:600;background:#fafbfc}.table td.num{text-align:right}
.badge{padding:5px 8px;border-radius:999px;font-size:11px;font-weight:700}.badge.green{background:#dcfce7;color:#166534}.badge.orange{background:#ffedd5;color:#9a3412}.badge.red{background:#fee2e2;color:#991b1b}
.btn{border:1px solid var(--line);background:#fff;padding:9px 13px;border-radius:9px;font-weight:650;font-size:13px}.btn:hover{background:#f8fafc}.btn.primary{background:var(--primary);color:#fff;border-color:var(--primary)}.btn.primary:hover{background:var(--primary-dark)}.btn.danger{color:#fff;background:var(--danger);border-color:var(--danger)}.btn.ghost{background:transparent}.btn.full{width:100%;padding:11px}
.actions{display:flex;gap:8px;flex-wrap:wrap}
.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.form-grid .full-col{grid-column:1/-1}
label{display:grid;gap:6px;font-size:12px;color:#475569;font-weight:650}
input,select,textarea{width:100%;padding:10px 11px;border:1px solid #dbe1e8;border-radius:9px;background:#fff;outline:none}
input:focus,select:focus,textarea:focus{border-color:#93c5fd;box-shadow:0 0 0 3px #dbeafe}
textarea{min-height:90px;resize:vertical}
.toolbar{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:16px}.search{max-width:320px}
.page-grid{display:grid;gap:18px}
.login-screen{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#eef4ff,#f8fafc)}
.login-card{width:min(420px,100%);background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px;box-shadow:var(--shadow)}
.login-card h1{margin:18px 0 4px;font-size:24px}.login-card p{margin:0 0 22px;color:var(--muted)}.login-card form{display:grid;gap:14px}.login-card small{display:block;color:var(--muted);margin-top:16px}.message{font-size:13px;color:var(--danger);min-height:18px}
.kpi-icon{width:40px;height:40px;border-radius:10px;background:#eff6ff;display:grid;place-items:center}
.empty{padding:35px;text-align:center;color:var(--muted)}
.toast{position:fixed;right:20px;bottom:20px;background:#111827;color:#fff;padding:12px 15px;border-radius:10px;box-shadow:var(--shadow);z-index:100}
.invoice{max-width:900px;margin:auto;background:#fff;border:1px solid #ddd;padding:35px}
.invoice-head{display:flex;justify-content:space-between;gap:20px}.invoice-title{font-size:28px;font-weight:800}.invoice-total{font-size:22px;font-weight:800}
@media(max-width:1100px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){
  .sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:translateX(0)}
  .main{margin-left:0}.topbar{padding:0 16px}.top-actions .user-pill{display:none}#menuBtn{display:block}
  .content{padding:16px}.cards{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.topbar h2{font-size:17px}
}
@media print{.sidebar,.topbar,.no-print{display:none!important}.main{margin:0}.content{padding:0}.invoice{border:0;box-shadow:none}}
